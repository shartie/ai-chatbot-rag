# Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# OpenAI API key - get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=****

# PostgreSQL database connection URL
POSTGRES_URL=****

# Redis connection URL for resumable streams (optional)
# Format: redis://[[username][:password]@][host][:port][/db-number]
REDIS_URL=****

# Documentation API configuration for Doc Chat Agent (optional)
# Base URL for your documentation REST API
DOC_API_BASE_URL=https://api.example.com/docs
# API key for authentication (if required)
DOC_API_KEY=****
