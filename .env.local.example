# Local development environment
# Copy this file to .env.local and fill in the values

# Generate a random secret: openssl rand -base64 32
AUTH_SECRET=your-secret-here

# OpenAI API key (optional for testing with mock mode)
OPENAI_API_KEY=sk-your-openai-key

# PostgreSQL - Docker Compose local setup
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/ai_chatbot

# Redis - Docker Compose local setup
REDIS_URL=redis://localhost:6379

# Documentation API configuration for Doc Chat Agent (optional)
# Leave empty to use mock mode for testing
DOC_API_BASE_URL=
DOC_API_KEY=

# Force mock mode for doc search (auto-enabled if DOC_API_KEY is empty)
# DOC_SEARCH_MOCK=true
